# GeoNode .env — sample keys from the fleet's Node-1 deployment.
# Replace every placeholder before use. Secrets are never committed.
# Fleet-verified values are marked; everything else is a placeholder.
HTTP_PORT=8083
HTTPS_PORT=443
SITEURL=http://<SITEURL_HOST>:8083/
LETSENCRYPT_MODE=disabled
# SECRET_KEY: the fleet uses a random value; generate one per deployment.
SECRET_KEY=<GENERATE_A_RANDOM_SECRET_KEY>
# Org contact used on Node-1 (fleet record); replace for your own deployment.
ORG_EMAIL=<ORG_CONTACT_EMAIL>
# GeoServer heap, reduced from 4G/4G on Node-1 (inspect-verified live):
GEOSERVER_JAVA_OPTS=-Xms1G -Xmx2G
